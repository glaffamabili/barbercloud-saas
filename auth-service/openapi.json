{
  "openapi": "3.0.3",
  "info": {
    "title": "BarberCloud SaaS — Auth & Identity Service API",
    "version": "2.0.0",
    "description": "Microsserviço de Identidade, 2FA por E-mail, Recuperação de Senha, RBAC Multi-Papel (cliente, profissional, admin) e Controle de Ciclo de Vida de Assinaturas Stripe do BarberCloud SaaS."
  },
  "paths": {
    "/register": {
      "post": {
        "summary": "Cadastro de conta com validação DNS MX e código de ativação",
        "responses": { "200": { "description": "Código de ativação enviado" }, "400": { "description": "E-mail inválido ou em uso" } }
      }
    },
    "/verify-email": {
      "post": {
        "summary": "Validação do código de 6 dígitos para ativar conta",
        "responses": { "200": { "description": "Conta ativada" }, "400": { "description": "Código inválido ou expirado" } }
      }
    },
    "/login": {
      "post": {
        "summary": "Autenticação primária com disparo de código 2FA por e-mail",
        "responses": { "200": { "description": "Código 2FA enviado" }, "401": { "description": "Credenciais inválidas" } }
      }
    },
    "/verify-2fa": {
      "post": {
        "summary": "Validação do segundo fator (2FA) e retorno do perfil e plano SaaS",
        "responses": { "200": { "description": "Sessão autenticada" }, "400": { "description": "Código 2FA inválido" } }
      }
    },
    "/forgot-password": {
      "post": {
        "summary": "Solicitação de link de recuperação de senha (expira em 30 min)",
        "responses": { "200": { "description": "E-mail enviado" } }
      }
    },
    "/reset-password": {
      "post": {
        "summary": "Redefinição de senha com token temporário",
        "responses": { "200": { "description": "Senha atualizada" } }
      }
    },
    "/users": {
      "get": {
        "summary": "Lista usuários com papel RBAC e status de assinatura Stripe",
        "responses": { "200": { "description": "Lista de usuários" } }
      }
    },
    "/users/{id}/role": {
      "patch": {
        "summary": "Atualiza papel RBAC (cliente, profissional, admin)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Papel atualizado" } }
      }
    },
    "/users/{id}/subscription": {
      "patch": {
        "summary": "Atualiza plano (free/pro) e status da assinatura Stripe do usuário",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Assinatura atualizada" } }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check real de conectividade com MariaDB",
        "responses": { "200": { "description": "Serviço UP" }, "503": { "description": "Serviço DOWN" } }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Métricas Prometheus do Auth Service",
        "responses": { "200": { "description": "Exposição OpenMetrics" } }
      }
    }
  }
}
