{
  "openapi": "3.0.3",
  "info": {
    "title": "BarberCloud SaaS — Core Business & Subscriptions API",
    "version": "2.0.0",
    "description": "API completa do BarberCloud SaaS: Catálogo de Serviços da Barbearia, CRUD de Agendamentos com Isolamento Multi-Tenant, Avaliações, Upload MinIO S3, Assinaturas Recorrentes Stripe (Free R$ 0 vs Pro R$ 29,90/mês), Portal do Cliente, Webhooks Idempotentes e Painel Admin de Métricas SaaS & MRR."
  },
  "paths": {
    "/api/register": { "post": { "summary": "Cadastro de conta (cliente ou profissional) com DNS MX", "responses": { "200": { "description": "OK" } } } },
    "/api/verify-email": { "post": { "summary": "Ativação de conta com código de 6 dígitos", "responses": { "200": { "description": "OK" } } } },
    "/api/login": { "post": { "summary": "Login com envio de código 2FA por e-mail", "responses": { "200": { "description": "OK" } } } },
    "/api/verify-2fa": { "post": { "summary": "Confirmação do código 2FA e início de sessão", "responses": { "200": { "description": "OK" } } } },
    "/api/me": { "get": { "summary": "Dados do usuário autenticado, papel e plano ativo", "responses": { "200": { "description": "OK" } } } },
    "/api/servicos": {
      "get": { "summary": "Listar catálogo de serviços ativos da barbearia", "responses": { "200": { "description": "Lista de serviços" } } },
      "post": { "summary": "Cadastrar novo serviço no catálogo (Restrito a profissional ou admin)", "responses": { "201": { "description": "Criado" }, "403": { "description": "Acesso negado para papel cliente" } } }
    },
    "/api/servicos/{id}": {
      "get": { "summary": "Obter detalhes de um serviço", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Detalhe" } } },
      "put": { "summary": "Editar serviço (Restrito ao profissional responsável ou admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Atualizado" }, "403": { "description": "Forbidden" } } },
      "delete": { "summary": "Desativar/remover serviço", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Removido" } } }
    },
    "/api/servicos/{id}/foto": {
      "post": { "summary": "Upload de foto do serviço/corte para o MinIO S3", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Foto enviada ao MinIO" } } }
    },
    "/api/agendamentos": {
      "get": { "summary": "Listar agendamentos (Isolamento Multi-Tenant por usuário)", "responses": { "200": { "description": "Lista isolada por tenant/usuário" } } },
      "post": { "summary": "Criar novo agendamento (Aplica limite de 3 ativos no Plano Free)", "responses": { "201": { "description": "Agendado" }, "403": { "description": "Limite do Plano Free atingido (PLAN_LIMIT_REACHED)" } } }
    },
    "/api/agendamentos/{id}": {
      "get": { "summary": "Detalhar agendamento (Retorna 403 se pertencer a outro cliente)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Detalhe" }, "403": { "description": "Isolamento Multi-Tenant violado" } } },
      "put": { "summary": "Editar horário, observações ou status do agendamento (Isolamento 403)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Atualizado" }, "403": { "description": "Forbidden" } } },
      "delete": { "summary": "Cancelar/excluir agendamento (Isolamento 403)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Cancelado" }, "403": { "description": "Forbidden" } } }
    },
    "/api/agendamentos/{id}/comprovante": {
      "post": { "summary": "Upload de comprovante/referência no MinIO S3 vinculado ao agendamento", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Comprovante salvo no MinIO" } } }
    },
    "/api/avaliacoes": {
      "get": { "summary": "Listar avaliações de atendimentos", "responses": { "200": { "description": "Avaliações" } } },
      "post": { "summary": "Publicar avaliação de atendimento", "responses": { "201": { "description": "Criada" } } }
    },
    "/api/plans": {
      "get": { "summary": "Listar planos SaaS (Free R$ 0 vs Pro R$ 29,90/mês)", "responses": { "200": { "description": "Planos" } } }
    },
    "/api/subscriptions/checkout": {
      "post": { "summary": "Criar sessão de assinatura recorrente no Stripe (mode=subscription)", "responses": { "200": { "description": "Sessão criada" } } }
    },
    "/api/billing/portal": {
      "post": { "summary": "Abrir Portal do Cliente (Stripe Billing Portal) para trocar plano ou cancelar", "responses": { "200": { "description": "URL do portal gerada" } } }
    },
    "/api/webhooks/stripe": {
      "post": { "summary": "Webhook assinado e idempotente para os 4 eventos do Stripe (checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed)", "responses": { "200": { "description": "Evento processado com idempotência" }, "400": { "description": "Assinatura inválida" } } }
    },
    "/api/admin/saas-metrics": {
      "get": { "summary": "Painel Admin SaaS: Usuários por plano, assinaturas ativas, MRR de teste e últimos eventos do Redis", "responses": { "200": { "description": "Métricas executivas SaaS" }, "403": { "description": "Restrito a admin" } } }
    },
    "/api/profile": {
      "get": { "summary": "Obter perfil completo do usuário logado", "responses": { "200": { "description": "Perfil" } } },
      "put": { "summary": "Atualizar nome e bio", "responses": { "200": { "description": "Atualizado" } } }
    },
    "/api/profile/{id}": {
      "get": { "summary": "Obter perfil público de um usuário", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Perfil público" } } }
    },
    "/api/profile/upload-photo": {
      "post": { "summary": "Upload de foto de perfil para o MinIO S3", "responses": { "200": { "description": "Foto enviada" } } }
    },
    "/api/profile/avatar/{key}": {
      "get": { "summary": "Servir objeto/imagem armazenado no MinIO", "parameters": [{ "name": "key", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Stream de imagem" } } }
    },
    "/api/users": {
      "get": { "summary": "Listar todos os usuários (Admin)", "responses": { "200": { "description": "Usuários" } } }
    },
    "/api/admin/logs": {
      "get": { "summary": "Consultar trilha de eventos do Redis Streams (Admin)", "responses": { "200": { "description": "Logs" } } }
    },
    "/health": {
      "get": { "summary": "Health check real de MariaDB, Auth, Log/Redis e MinIO", "responses": { "200": { "description": "UP" } } }
    },
    "/metrics": {
      "get": { "summary": "Métricas Prometheus", "responses": { "200": { "description": "OpenMetrics" } } }
    }
  }
}
